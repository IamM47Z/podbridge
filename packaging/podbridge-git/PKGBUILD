# Maintainer: IamM47Z
pkgname=podbridge-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="AirPods on Linux: battery, ear detection, noise control, auto-connect and the high-quality mic"
arch=('x86_64')
url="https://github.com/IamM47Z/podbridge"
license=('AGPL-3.0-only')
depends=('bluez' 'libpulse' 'dbus' 'ffmpeg' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('git' 'rust' 'cargo' 'clang')
provides=('podbridge')
conflicts=('podbridge')
source=("git+https://github.com/IamM47Z/podbridge.git")
sha256sums=('SKIP')

pkgver() {
  cd "podbridge"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "podbridge"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "podbridge"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "podbridge"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "podbridge"
  local id=io.github.iamm47z.podbridge
  install -Dm755 target/release/podbridge "$pkgdir/usr/bin/podbridge"
  install -Dm644 "assets/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$id.png"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" NOTICE assets/font/Inter-OFL.txt assets/font/DejaVu-LICENSE.txt
}
